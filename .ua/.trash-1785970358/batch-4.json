      "name": "BaseDamageCalc.svelte",
      "filePath": "src/BaseDamageCalc.svelte",
      "summary": "Core damage calculation component for the Voxel Blade build optimizer. Computes per-hit and per-tick damage from weapon stats, damage type bonuses, boosts, crit, and proc effects (Cauterize, Echo Incineration, Stormcaller, Bombardier, Quake, Runic Blades), driven by a large set of props from DamageAnalyzer, and renders detailed breakdown tables.",
      "tags": ["component", "damage-calculator", "simulation", "game-data"],
      "complexity": "complex",
      "languageNotes": "Svelte 5 component using runes-based reactivity; receives the bulk of its inputs via an ~80-prop interface."
    },
