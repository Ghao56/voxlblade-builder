{
  "nodes": [
    {
      "id": "file:src/lib/types.ts",
      "type": "file",
      "name": "types.ts",
      "filePath": "src/lib/types.ts",
      "summary": "Core type definitions module for the voxlblade-builder project. Defines fundamental stat types (StatKey, StatMap), equipment interfaces (Race, Guild, Armor, Ring, Rune), weapon component types (WeaponBlade, WeaponHandle, MonkGlove, MonkEssence), the full BuildState interface, proc coefficient handling (ProcCoefficient, ProcScalingType), boost system types (BoostEntry, BoostResult), and upgrade logic. Also re-exports DMG_TYPE_COLORS and DMG_TYPE_PRIORITY from constants. This file is the foundational type layer imported by nearly every other module in the engine and data layers.",
      "tags": ["types", "interfaces", "constants", "core", "foundational"],
      "complexity": "low"
    },
    {
      "id": "function:src/lib/types.ts:applyUpgrade",
      "type": "function",
      "name": "applyUpgrade",
      "summary": "Applies an upgrade level multiplier to a StatMap. Positive stat values are scaled up by (1 + level * 0.1) and negative values are scaled down (divided), producing an upgraded copy of the stats. Returns a shallow copy with no mutation.",
      "tags": ["stat-calculation", "upgrade", "pure-function"],
      "complexity": "low"
    },
    {
      "id": "function:src/lib/types.ts:getProcCoeffValue",
      "type": "function",
      "name": "getProcCoeffValue",
      "summary": "Extracts the numeric proc coefficient value from a ProcCoefficient union type. Returns 0 for 'noProc', the stored value for 'hasCoeff', and a default of 1 when undefined.",
      "tags": ["proc-coefficient", "utility", "pure-function"],
      "complexity": "low"
    },
    {
      "id": "function:src/lib/types.ts:canProc",
      "type": "function",
      "name": "canProc",
      "summary": "Determines whether a given ProcCoefficient allows procing by checking if its resolved value is greater than 0. Delegates to getProcCoeffValue.",
      "tags": ["proc-coefficient", "utility", "pure-function"],
      "complexity": "low"
    }
  ],
