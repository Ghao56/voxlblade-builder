                  {
                      "id":  "file:src/data/Perkbasedmg.ts",
                      "type":  "file",
                      "name":  "Perkbasedmg.ts",
                      "filePath":  "src/data/Perkbasedmg.ts",
                      "summary":  "Perk-based damage definitions module for the Voxel Blade calculator. Exports the large PERK_DMG_DEFS registry of ~70 PerkDmgDef entries (Springblast, Bomber Charge, Dragon Claw/Bubble, Monk spirits, Ichor Spark, Divine Crash, DoT-synergy perks, etc.), each with base-damage formulas, hits, damage types/scalings, proc coefficients, HP-gates, sliders, and secondary effects, plus HpGate helpers and registry lookup.",
                      "tags":  [
                                   "perk",
                                   "damage",
                                   "calculator",
                                   "registry",
                                   "game-data",
                                   "hp-gate",
                                   "build-optimizer"
                               ],
                      "complexity":  "complex",
                      "languageNotes":  "TypeScript module using a table-of-definitions pattern: each perk entry is a plain object typed as the exported PerkDmgDef interface with inline arrow-function getters. Module-level side effect builds a lookup Map on import; many base-damage formulas are rounded to 3-4 decimals."
                  },
                  {
                      "id":  "module:src/data/Perkbasedmg.ts:PERK_DMG_DEFS",
                      "type":  "module",
